# ============================================================================
# Watchizer — Laravel Backend PRODUCTION environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` on the production server and fill in the real
# secrets. `.env.production` (the filled copy) is gitignored — NEVER commit
# real credentials. Values marked "# KEEP EXISTING" must be carried over from
# the current server .env unchanged (rotating them invalidates live sessions).
#
# Deploy:  cp .env.production .env  &&  php artisan config:cache
# ============================================================================

APP_NAME=Watchizer
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dash.watchizereg.com
APP_KEY=                              # KEEP EXISTING APP_KEY (base64:...) — do NOT regenerate

# Public storefront (Next.js) origin — used for CORS + frontend_url
FRONTEND_URL=https://watchizereg.com

LOG_CHANNEL=stack
LOG_LEVEL=error                       # production: error only (never debug)

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=watchizer
DB_USERNAME=                          # YOUR PROD DB USER
DB_PASSWORD=                          # YOUR PROD DB PASSWORD

# ── JWT (tymon/jwt-auth) ────────────────────────────────────────────────────
JWT_SECRET=                           # KEEP EXISTING JWT_SECRET — do NOT change

# ── Public API key (separate secret from JWT_SECRET) ────────────────────────
PUBLIC_API_KEY=                       # KEEP EXISTING PUBLIC_API_KEY

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                     # YOUR GOOGLE CLIENT ID
GOOGLE_CLIENT_SECRET=                 # YOUR ROTATED GOOGLE CLIENT SECRET
GOOGLE_REDIRECT_URI=https://dash.watchizereg.com/api/auth/google/callback

# ── Microsoft OAuth (optional — leave blank if unused) ──────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://dash.watchizereg.com/api/auth/microsoft/callback

# ── Paymob (payment gateway) ────────────────────────────────────────────────
PAYMOB_PUBLIC_KEY=                    # YOUR PAYMOB PUBLIC KEY
PAYMOB_SECRET_KEY=                    # YOUR PAYMOB SECRET KEY
PAYMOB_HMAC_SECRET=                   # YOUR PAYMOB HMAC SECRET

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=                            # YOUR SMTP HOST (e.g. smtp.hostinger.com)
MAIL_PORT=587
MAIL_USERNAME=                        # YOUR SMTP USERNAME
MAIL_PASSWORD=                        # YOUR SMTP PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@watchizereg.com
MAIL_FROM_NAME=Watchizer

# Comma-separated admins that receive new-order notifications
ORDER_ADMIN_EMAILS=

# ── Queue / Cache / Session / Filesystem ────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ── Asset base (absolute host for image URLs in API responses) ──────────────
ASSET_BASE=https://dash.watchizereg.com
