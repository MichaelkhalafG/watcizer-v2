APP_NAME="Watchizer Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

# Arabic-first: ar is the default locale, en the fallback.
APP_LOCALE=ar

# Unset = Secure everywhere except APP_ENV=local (config/session.php). Override only deliberately.
# SESSION_SECURE_COOKIE=
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# Must match the cost of the hashes the LEGACY app wrote ($2y$10$…). The dashboard signs staff in
# against the SHARED `users` table, so a mismatch here plus Laravel's `rehash_on_login` would have
# rewritten a legacy column on every login; `config/hashing.php` turns that off and pins the cost,
# and `tests/Feature/Manage/AuthTest.php` asserts the runtime value still equals the production
# hash cost so the defence cannot rot silently again (review 2026-09-11 🟠-2).
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# One MariaDB database shared with the legacy app. The core app only ever
# creates/writes catalog_*, storefront_*, inventory_*, integration_* tables
# (plus its own core_migrations repository). Never point this at production
# from a workstation.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional overrides for the read-only `legacy` connection (defaults to DB_*).
# LEGACY_DB_HOST=
# LEGACY_DB_DATABASE=
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=

# Shared-hosting launch profile: file cache with version keys, sync queue,
# file sessions. Redis only after a VPS move.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=core

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Bulk mail (restock alerts, re-engagement) may use at most MAIL_DAILY_CAP - MAIL_TRANSACTIONAL_RESERVE
# messages a day, minus what already went out; order/account mail never checks this.
MAIL_DAILY_CAP=100
MAIL_TRANSACTIONAL_RESERVE=40
MAIL_BULK_PER_RUN=20

# The storefront SERVER's own API rate limit (2026-09-30). A SECRET, at least 32 characters, set to the
# SAME value in the storefront server's environment (STOREFRONT_SERVER_KEY, never NEXT_PUBLIC_).
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"  — empty = off (per-IP 60 for the server).
STOREFRONT_SERVER_KEY=
STOREFRONT_SERVER_RATE=1200

# Where the dashboard lives, for the "Open Order" button in the admin order e-mail.
# PINNED, not derived: that link used to come from route(), which takes its host from the request —
# and the e-mail is composed while serving add_order on the API host, where .htaccess 404s /manage.
# Leave it unset to use the built-in https://eleganceeg.com.
MANAGE_URL=

VITE_APP_NAME="${APP_NAME}"

# Legacy-compat layer (wave 2): the public Api-Code the storefront sends, and the legacy origin to proxy to.
# SWITCH-NIGHT PREREQUISITE (f), study 3.4.1: COMPAT_API_KEY must equal the legacy app's PUBLIC_API_KEY.
# The legacy CheckApiMiddleware is its FIRST api middleware, so a mismatch is 401 on every proxied
# request, not a degraded mode. Verify with: php artisan compat:env-parity --token="<live session JWT>"
COMPAT_API_KEY=
COMPAT_ASSET_BASE=https://api.watchizereg.com
COMPAT_LEGACY_BASE=https://dash.watchizereg.com
STOREFRONT_ASSET_BASE=https://api.watchizereg.com

# Customer JWT. Core VERIFIED these from wave 3; since storefront Phase 1 (2026-09-21) it also
# ISSUES them, in the same tymon-shaped claim set, so a token works on either host.
# Must equal the legacy application JWT_SECRET. Developer-handled, never committed.
JWT_SECRET=
JWT_ALGO=HS256
# Clock tolerance in SECONDS when verifying a token's `exp` and `nbf`.
#
# 60, not 0. Two hosts mint tokens that this application verifies — the legacy app until it is
# switched off, and core — and their clocks are not the same clock. At 0 a token whose `nbf` is
# one second ahead of core's clock is REFUSED, and the symptom is a customer who signs in
# successfully and is immediately a guest again, with nothing in any log: `LegacyJwt` treats an
# unverifiable token exactly as it treats no token. Set the SAME value on both hosts.
#
# It is a tolerance, not a grace period: 60 seconds past expiry on a 30-day token is noise.
JWT_LEEWAY=60
# Token lifetime in MINUTES. 43200 = 30 days = the legacy app's own jwt.ttl default, so a token
# core issues expires exactly when one the legacy app issued would have. An unset SECRET is safe
# in one direction only: verification refuses every token, issuance refuses to run rather than
# sign with an empty string.
JWT_TTL=43200

# Social sign-in (storefront Phase 1, piece 5). Developer-handled, never committed.
# The redirect URI is read WHOLE and must match the provider console byte for byte — it is not
# built from APP_URL, because concatenating a base with a path is how a doubled slash silently
# invalidates every callback. Register THIS host's URI alongside the legacy one, not instead of
# it, until the storefront is repointed: a customer mid-flow at the cutover otherwise lands on a
# URI the provider does not know.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=common
COMPAT_PAYMENT_RETURN_URL=https://watchizereg.com/
# Every OTHER storefront's site, comma-separated, for CORS (config/cors.php). Empty until a second
# shop's frontend goes up; its other addresses come from storefronts.domain (StorefrontUrls).
CORS_EXTRA_ORIGINS=

# Wave 4B - has the write-switch happened? FALSE until switch night, and the default must stay false:
# while it is off the dashboard refuses to CREATE a product, a variant, a category node or a lookup
# row, because the switch-night rebuild would delete it (AGENTS 2.23, study 3.12.10). Editing,
# placement, images and visibility are open either way. Flipped at study 3.4 step 3g - a flag, not a
# date, so nothing infers the state from the clock.
CORE_WRITE_SWITCH_COMPLETED=false

# Item 5 (2026-09-18) - do those pre-switch gates REFUSE, or warn? The developer asked for every
# gated feature open and exercised before the switch: a gate nobody has opened is a gate nobody
# knows the shape of. With "warn" the same screens carry the same sentence as a caveat and the
# controls work; with "enforce" the refusals come back. This is deliberately a SEPARATE switch from
# the flag above: that one means "legacy has stopped writing" and ConversionGuard reads it, because
# converting a live product to variants while legacy still writes products.quantity corrupts stock.
# Lost typing you can type again; lost stock figures you cannot.
CORE_PRE_SWITCH_GATES=warn

# Paymob — developer-handled, never committed. Unset means the card branch answers the
# legacy "payment could not be initiated" 422 instead of failing silently.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=

# Meta Conversions API (B2) — the server-side Purchase for a CARD order, sent from the payment
# callback. Token: developer-handled, never committed; empty = nothing is sent. Swapping it is this
# one line + `php artisan config:cache`. Check with `php artisan meta:capi-check` (never prints it).
# TEST_EVENT_CODE set = events go to Events Manager → Test events only; empty = they count.
META_CAPI_TOKEN=
META_CAPI_PIXEL_ID=1614877760150035
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v23.0

# Wave 4D - the CA bundle the catalogue importer verifies a supplier's HTTPS certificate against,
# for the cover images it fetches. Leave EMPTY on a host whose cURL already finds the system store;
# a stock PHP on Windows does not, and every fetch then fails with "unable to get local issuer
# certificate" - which is what the first real import run hit. Verification is never disabled.
#   example (XAMPP): MEDIA_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt
MEDIA_CA_BUNDLE=

# Meta catalogue feed (config/feeds.php): 40 letters/digits, the feed URL's only credential. Empty = no feed.
# php -r "echo bin2hex(random_bytes(20)), PHP_EOL;"
FEED_META_WATCHIZER_TOKEN=
