APP_NAME="Watchizer Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

# Arabic-first: ar is the default locale, en the fallback.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# One MariaDB database shared with the legacy app. The core app only ever
# creates/writes catalog_*, storefront_*, inventory_*, integration_* tables
# (plus its own core_migrations repository). Never point this at production
# from a workstation.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional overrides for the read-only `legacy` connection (defaults to DB_*).
# LEGACY_DB_HOST=
# LEGACY_DB_DATABASE=
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=

# Shared-hosting launch profile: file cache with version keys, sync queue,
# file sessions. Redis only after a VPS move.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=core

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
