<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The whole suite runs in ONE process, and the media tests decode and pad real images:
            a 1200x1200 true-colour canvas is ~5.8 MB, and the 128 MB php.ini default was exhausted
            once the wave-4B upload probes joined the run (the fatal lands in ImagePipeline::fit()
            at whichever image test happens to be last, which reads as an image bug and is not one).
            Raised here rather than in a command-line flag, because `php artisan test` spawns Pest
            as a child process and `php -d memory_limit=...` does NOT reach it.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="COMPAT_WARM_ON_WRITE" value="false"/>
        <!-- DB_* deliberately NOT overridden: tests run on the local MariaDB copy inside rolled-back transactions (Tests\TestCase). -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            The suite's temporary files (2026-10-16, DEFENDER-TEST-FIXTURE): every test that writes a
            scratch file reaches it through sys_get_temp_dir(), which on Windows is whatever TMP names.
            Left alone that is the USER's %TEMP%, where the adversarial upload fixture — a PHP web-shell
            signature disguised as an image, written to prove the uploader refuses it — gets quarantined
            by Defender mid-run, and where no narrow exclusion is possible. So the suite owns its own
            directory: storage/framework/testing/tmp (gitignored, created with the repo). The path is
            relative to the directory the suite runs from (core/); PHP resolves it to an absolute path.
            On Linux/macOS the variable is ignored by sys_get_temp_dir() and the test asserting the
            location skips itself.
        -->
        <env name="TMP" value="storage/framework/testing/tmp" force="true"/>
        <env name="TEMP" value="storage/framework/testing/tmp" force="true"/>
    </php>
</phpunit>
