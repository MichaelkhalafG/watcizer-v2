# ---------------------------------------------------------------------------
# Root .gitignore — rewritten 2026-09-06 as UTF-8 (the previous file had a
# UTF-16 section that git silently ignored). This repo is PUBLIC.
# Companion guard: scripts/git-hooks/pre-commit (install: scripts/install-hooks.ps1)
# ---------------------------------------------------------------------------

# ---- Data safety -----------------------------------------------------------
# Database dumps and archives never enter the repo. The only exception is a
# structure-only schema export (no rows).
*.sql
!*_structure_only.sql
*.sql.gz
*.zip
_private*/

# ---- Planning material (public-repo rule) ----------------------------------
# Everything under "new branding/" is planning/business material and stays
# on disk only. Explicit sub-rules are kept for clarity even though the whole
# folder is excluded; code that must ship later gets its own folder outside.
new\ branding/
new\ branding/docs/
new\ branding/*STUDY*.md
new\ branding/*DRIFT_REPORT*.md
new\ branding/AGENTS.md
new\ branding/CLAUDE.md
# Agent/planning files are never published (solo-developer policy, AGENTS.md §1):
# the root CLAUDE.md pointer stays on disk only, and both names are blocked at any path.
/CLAUDE.md
CLAUDE.md
AGENTS.md
new\ branding/bf-archive/
new\ branding/design/
# The same documents are excluded wherever they live (docs/ today).
*STUDY*.md
*DRIFT_REPORT*.md

# ---- Secrets and local environment -----------------------------------------
.env
.env.*
!.env.example
!.env.*.example
client_secret_*.json
backend/.env.testing
auth.json

# ---- Tooling / local state -------------------------------------------------
.claude
.claude*
audit/
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/bootstrap/cache/*.php
backend/storage/framework/views/*.php
backend/storage/logs/*.log
backend/public/Uploads_Images/

# ---- Dependencies / build output -------------------------------------------
node_modules/
vendor/
!backend/public/DashAssets/vendor/
.next/
dist/
build/
*.log

# ---- OS / editor junk ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
.fleet/

graphify-out/
.graphifyignore

# deploy archives
*.tar.gz
exclude.txt
