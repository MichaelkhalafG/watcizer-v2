# Production environment (loaded by `next build` / `next start` when NODE_ENV=production
# AND no .env.local shadows these — .env.local is dev-only and gitignored, so it is
# absent on the deploy/build server). Keeps localhost out of production metadata (I-2).
#
# Frontend site domain: https://watchizereg.com (canonical/OG urls — hardcoded in code as SEO_DOMAIN).
# Backend (API + uploaded images): https://dash.watchizereg.com.

# Public API base for client + server fetches.
NEXT_PUBLIC_API_BASE=https://dash.watchizereg.com/api

# Origin the Next rewrites proxy /api, /Uploads_Images and /sitemap.xml to.
LARAVEL_ORIGIN=https://dash.watchizereg.com

# SINGLE source of truth for the image/asset host. Every og:image, twitter:image,
# JSON-LD image[] and next/image src is built from this via src/lib/env.js → getImageUrl.
# Must be the HTTPS CDN host in prod so no 127.0.0.1 leaks into crawlable metadata.
NEXT_PUBLIC_ASSET_BASE=https://dash.watchizereg.com

# Optional CDN image resizer (unused unless set) — left empty, same as dev.
NEXT_PUBLIC_IMAGE_CDN_BASE=

# Enable Paymob card-payment flow in production (non-secret feature flag).
NEXT_PUBLIC_PAYMOB_ENABLED=true
