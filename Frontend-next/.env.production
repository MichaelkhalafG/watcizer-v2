# Watchizer Next.js — Production Environment
# Frontend: https://watchizereg.com
# API:      https://api.watchizereg.com   (core — storefront Phase 2, 2026-09-22)
#
# ROLLBACK IS THIS FILE. Reverting the three hosts below to https://dash.watchizereg.com and
# pushing to main puts the storefront back on the legacy application; one Hostinger build is the
# whole recovery, and nothing on the server has to be undone for it.
# See core/docs/deploy/RUNBOOK_PHASE2_STOREFRONT.md §8.

NEXT_PUBLIC_API_BASE=https://api.watchizereg.com/api
LARAVEL_ORIGIN=https://api.watchizereg.com
NEXT_PUBLIC_ASSET_BASE=https://api.watchizereg.com
NEXT_PUBLIC_IMAGE_CDN_BASE=
NEXT_PUBLIC_PUBLIC_API_KEY=rKvewz34LTry1S69wMebdHQkXnEpnDPcLoKzOfNbBKpCeF8Cqf6CmQidtuqluUZC
NEXT_PUBLIC_PAYMOB_ENABLED=true
# Meta (Facebook) pixels. Public by nature — they ship in the HTML of every page — but they live
# here so a pixel can be added, swapped or dropped by editing this ONE line, with no code edit.
#
# COMMA-SEPARATED. Every pixel listed is initialised and receives every event. Blank = no script,
# no noscript beacon, no events at all.
#
#   1611910119460872  the incumbent — ran on the Vite storefront, holds the campaign history
#   1614877760150035  the new one
#
# Dropping either later is a one-line edit: delete it and its comma.
NEXT_PUBLIC_META_PIXEL_ID=1611910119460872,1614877760150035
