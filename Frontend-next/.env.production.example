NEXT_PUBLIC_API_BASE=https://dash.watchizereg.com/api
NEXT_PUBLIC_ASSET_BASE=https://dash.watchizereg.com
NEXT_PUBLIC_IMAGE_CDN_BASE=
NEXT_PUBLIC_PUBLIC_API_KEY=your_api_key_here
NEXT_PUBLIC_PAYMOB_ENABLED=true
LARAVEL_ORIGIN=https://dash.watchizereg.com

# The server's own API rate limit at core (2026-09-30). A SECRET: the same value as core's
# STOREFRONT_SERVER_KEY, set only in the storefront SERVER's environment. Never prefix it NEXT_PUBLIC_.
STOREFRONT_SERVER_KEY=

# Meta (Facebook) pixel ids, comma-separated. Every one listed receives every event.
# Blank disables the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement id for this storefront (G-…). Blank = no Google tag at all.
# Watchizer: G-9N3N4BW58B. Brand Fashion: blank until the client creates its property.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
