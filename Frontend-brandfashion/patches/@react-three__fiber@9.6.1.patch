 var React = require('react');
 var THREE = require('three');
+
+// ── Watchizer patch (2026-10-01): THREE.Clock is deprecated since three r183 and warns on every
+// construction ("THREE.Clock: This module has been deprecated. Please use THREE.Timer instead.").
+// Fiber 9.x (up to 9.8.1) still builds its store clock by constructing a THREE Clock. This builds it on
+// THREE.Timer instead, with the SAME interface and the same arithmetic as Clock — autoStart,
+// running, startTime, oldTime, elapsedTime, start(), stop(), getDelta(), getElapsedTime() — so
+// fiber and every `state.clock` reader behave exactly as before. Drop this patch when fiber moves
+// to THREE.Timer itself (fiber v10).
+function createTimerClock(T) {
+  const timer = new T.Timer();
+  return {
+    autoStart: true,
+    running: false,
+    startTime: 0,
+    oldTime: 0,
+    elapsedTime: 0,
+    start() {
+      this.startTime = performance.now();
+      this.oldTime = this.startTime;
+      this.elapsedTime = 0;
+      this.running = true;
+      timer.reset();
+    },
+    stop() {
+      this.getElapsedTime();
+      this.running = false;
+      this.autoStart = false;
+    },
+    getElapsedTime() {
+      this.getDelta();
+      return this.elapsedTime;
+    },
+    getDelta() {
+      let diff = 0;
+      if (this.autoStart && !this.running) {
+        this.start();
+        return 0;
+      }
+      if (this.running) {
+        timer.update();
+        diff = timer.getDelta();
+        this.oldTime = performance.now();
+        this.elapsedTime += diff;
+      }
+      return diff;
+    }
+  };
+}
